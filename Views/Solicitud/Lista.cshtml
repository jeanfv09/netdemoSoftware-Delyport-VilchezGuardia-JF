@model List<SISDELYPORT.Models.Solicitud>
@{
    ViewData["Title"] = "Solicitudes";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');
    body { background-color: #0d0a2e; font-family: 'DM Sans', sans-serif; }
    .page-wrap {
        background:
            radial-gradient(ellipse 90% 50% at 50% 0%, #3d2080 0%, transparent 55%),
            linear-gradient(180deg, #0d0a2e 0%, #130d3a 25%, #0d0a2e 100%);
        min-height: 100vh;
        padding: 60px 0 80px;
        color: white;
    }
    .section-label {
        color: #c9a84c;
        letter-spacing: 4px;
        font-size: 0.72rem;
        text-transform: uppercase;
        font-weight: 500;
    }
    .page-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 700;
    }
    .tabla-wrap {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        overflow: hidden;
    }
    .tabla-header {
        display: grid;
        grid-template-columns: 110px 1fr 1fr 130px 110px 120px;
        padding: 14px 24px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        background: rgba(255,255,255,0.03);
    }
    .tabla-header span {
        color: rgba(255,255,255,0.3);
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 500;
    }
    .tabla-fila {
        display: grid;
        grid-template-columns: 110px 1fr 1fr 130px 110px 120px;
        padding: 18px 24px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        align-items: center;
        transition: background 0.2s;
    }
    .tabla-fila:last-child { border-bottom: none; }
    .tabla-fila:hover { background: rgba(255,255,255,0.02); }
    .badge-codigo {
        background: rgba(201,168,76,0.1);
        color: #c9a84c;
        border: 1px solid rgba(201,168,76,0.25);
        padding: 3px 10px;
        border-radius: 3px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1px;
    }
    .badge-pendiente {
        background: rgba(250,204,21,0.1);
        color: #facc15;
        border: 1px solid rgba(250,204,21,0.25);
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .badge-validado {
        background: rgba(74,222,128,0.1);
        color: #4ade80;
        border: 1px solid rgba(74,222,128,0.25);
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .badge-rechazado {
        background: rgba(248,113,113,0.1);
        color: #f87171;
        border: 1px solid rgba(248,113,113,0.25);
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .btn-gold {
        background: linear-gradient(135deg, #c9a84c, #e8c96a);
        color: #08061a;
        padding: 13px 36px;
        border-radius: 3px;
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
    }
    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(201,168,76,0.3);
        color: #08061a;
    }
    .btn-accion {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.6);
        padding: 6px 14px;
        border-radius: 4px;
        font-size: 0.78rem;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-block;
    }
    .btn-accion:hover {
        border-color: rgba(201,168,76,0.4);
        color: #c9a84c;
    }
    .alert-exito {
        background: rgba(74,222,128,0.06);
        border: 1px solid rgba(74,222,128,0.2);
        border-radius: 10px;
        padding: 16px 24px;
        color: #4ade80;
        margin-bottom: 28px;
    }
    .alert-error {
        background: rgba(248,113,113,0.06);
        border: 1px solid rgba(248,113,113,0.2);
        border-radius: 10px;
        padding: 16px 24px;
        color: #f87171;
        margin-bottom: 28px;
    }
    .stats-row {
        display: flex;
        gap: 16px;
        margin-bottom: 32px;
    }
    .stat-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px;
        padding: 20px 28px;
        flex: 1;
        text-align: center;
    }
    .stat-num {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
    }
    .stat-label {
        color: rgba(255,255,255,0.3);
        font-size: 0.75rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }
</style>

<div class="page-wrap">
    <div class="container">

        @if (TempData["Exito"] != null)
        {
            <div class="alert-exito">✅ @TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert-error">⚠️ @TempData["Error"]</div>
        }

        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <p class="section-label mb-1">DELYPORT · LEIMPORT</p>
                <h2 class="page-title" style="color:white; margin:0;">
                    Solicitudes de Transporte
                </h2>
            </div>
            <a asp-action="Registrar" class="btn-gold">+ Nueva Solicitud</a>
        </div>

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-num" style="color:#facc15;">
                    @Model.Count(s => s.Estado == "Pendiente")
                </div>
                <div class="stat-label">Pendientes</div>
            </div>
            <div class="stat-card">
                <div class="stat-num" style="color:#4ade80;">
                    @Model.Count(s => s.Estado == "Validado")
                </div>
                <div class="stat-label">Validadas</div>
            </div>
            <div class="stat-card">
                <div class="stat-num" style="color:#f87171;">
                    @Model.Count(s => s.Estado == "Rechazado")
                </div>
                <div class="stat-label">Rechazadas</div>
            </div>
            <div class="stat-card">
                <div class="stat-num" style="color:#c9a84c;">@Model.Count</div>
                <div class="stat-label">Total</div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="tabla-wrap">
            <div class="tabla-header">
                <span>Código</span>
                <span>Cliente</span>
                <span>Paquete</span>
                <span>Distrito</span>
                <span>Estado</span>
                <span>Acciones</span>
            </div>
            @foreach (var s in Model)
            {
                <div class="tabla-fila">
                    <div><span class="badge-codigo">@s.CodigoSolicitud</span></div>
                    <div style="color:rgba(255,255,255,0.8); font-size:0.9rem;">
                        @s.NombreCliente
                    </div>
                    <div style="color:rgba(255,255,255,0.5); font-size:0.85rem;">
                        @s.DescripcionPaquete
                    </div>
                    <div style="color:rgba(255,255,255,0.6); font-size:0.85rem;">
                        @s.DistritoDestino
                    </div>
                    <div>
                        @if (s.Estado == "Pendiente")
                        {
                            <span class="badge-pendiente">⏳ Pendiente</span>
                        }
                        else if (s.Estado == "Validado")
                        {
                            <span class="badge-validado">✅ Validado</span>
                        }
                        else
                        {
                            <span class="badge-rechazado">❌ Rechazado</span>
                        }
                    </div>
                    <div>
                        <a asp-action="Modificar" asp-route-id="@s.Id"
                           class="btn-accion">✏️ Editar</a>
                    </div>
                </div>
            }
        </div>

    </div>
</div>