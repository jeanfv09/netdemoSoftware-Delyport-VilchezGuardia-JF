@model SISDELYPORT.Models.Solicitud

@{
    ViewData["Title"] = "Modificar Solicitud";
    bool bloqueado = (bool)(ViewBag.Bloqueado ?? false);
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

    body {
        background-color: #0d0a2e;
        font-family: 'DM Sans', sans-serif;
    }

    .page-wrap {
        background:
            radial-gradient(ellipse 90% 50% at 50% 0%, #3d2080 0%, transparent 55%),
            linear-gradient(180deg, #0d0a2e 0%, #130d3a 25%, #0d0a2e 100%);
        min-height: 100vh;
        padding: 60px 0 80px;
        color: white;
    }

    .section-label {
        color: #c9a84c;
        letter-spacing: 4px;
        font-size: 0.72rem;
        text-transform: uppercase;
        font-weight: 500;
    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 700;
    }

    .form-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        padding: 40px;
        max-width: 750px;
        margin: 0 auto;
    }

    .form-label {
        color: rgba(255,255,255,0.3);
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        background: rgba(255,255,255,0.04) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        border-radius: 6px !important;
        color: rgba(255,255,255,0.8) !important;
        padding: 12px 16px !important;
        font-size: 0.95rem !important;
        transition: all 0.2s;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: rgba(201,168,76,0.4) !important;
        box-shadow: 0 0 0 3px rgba(201,168,76,0.08) !important;
        background: rgba(255,255,255,0.06) !important;
    }

    .form-control:disabled,
    .form-select:disabled {
        opacity: 0.35 !important;
        cursor: not-allowed !important;
    }

    .form-control option,
    .form-select option {
        background: #1a1040;
        color: white;
    }

    .btn-gold {
        background: linear-gradient(135deg, #c9a84c, #e8c96a);
        color: #08061a;
        padding: 13px 36px;
        border-radius: 3px;
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(201,168,76,0.3);
    }

    .btn-outline {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.5);
        padding: 13px 32px;
        border-radius: 3px;
        font-size: 0.82rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s;
        display: inline-block;
    }

    .btn-outline:hover {
        border-color: rgba(201,168,76,0.3);
        color: #c9a84c;
    }

    .alert-bloqueado {
        background: rgba(248,113,113,0.06);
        border: 1px solid rgba(248,113,113,0.2);
        border-radius: 10px;
        padding: 16px 24px;
        color: #f87171;
        margin-bottom: 28px;
        font-size: 0.9rem;
    }

    .historial-box {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 8px;
        padding: 16px 20px;
        color: rgba(255,255,255,0.4);
        font-size: 0.82rem;
        line-height: 1.8;
        margin-top: 8px;
    }

    .badge-codigo {
        background: rgba(201,168,76,0.1);
        color: #c9a84c;
        border: 1px solid rgba(201,168,76,0.25);
        padding: 4px 14px;
        border-radius: 3px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .section-divider {
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(201,168,76,0.25),
            transparent
        );
        margin: 28px 0;
    }

    .text-danger {
        color: #f87171 !important;
        font-size: 0.8rem;
    }
</style>

<div class="page-wrap">

    <div class="container">

        <div class="d-flex align-items-center gap-3 mb-4">

            <a asp-action="Lista"
               style="
                    color:rgba(255,255,255,0.3);
                    text-decoration:none;
                    font-size:0.85rem;
                    letter-spacing:1px;
               ">
                ← VOLVER
            </a>

            <span style="color:rgba(255,255,255,0.1);">|</span>

            <p class="section-label mb-0">
                HU-002 · MODIFICAR SOLICITUD
            </p>

        </div>

        <div style="max-width:750px; margin:0 auto;">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h2 class="page-title"
                    style="color:white; margin:0;">
                    Editar Solicitud
                </h2>

                <span class="badge-codigo">
                    @Model.CodigoSolicitud
                </span>

            </div>

            @if (bloqueado)
            {
                <div class="alert-bloqueado">

                    ⚠️ Esta solicitud tiene estado
                    <strong>@Model.Estado</strong>

                    y no puede ser modificada.

                    Solo se pueden editar solicitudes
                    en estado <strong>Pendiente</strong>.

                </div>
            }

            <div class="form-card">

                <form asp-action="Modificar" method="post">

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CodigoSolicitud" />
                    <input type="hidden" asp-for="Estado" />
                    <input type="hidden" asp-for="FechaRegistro" />
                    <input type="hidden" asp-for="HistorialCambios" />

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label class="form-label">
                                Nombre del Cliente
                            </label>

                            <input asp-for="NombreCliente"
                                   class="form-control"
                                   readonly="@bloqueado" />

                            <span asp-validation-for="NombreCliente"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Distrito de Destino
                            </label>

                            <select asp-for="DistritoDestino"
                                    class="form-select"
                                    disabled="@bloqueado">

                                <option value="">
                                    -- Seleccione --
                                </option>

                                @foreach (var d in ViewBag.Distritos as List<string>)
                                {
                                    <option value="@d">
                                        @d
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="DistritoDestino"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-8">

                            <label class="form-label">
                                Descripción del Paquete
                            </label>

                            <textarea asp-for="DescripcionPaquete"
                                      class="form-control"
                                      rows="3"
                                      readonly="@bloqueado"></textarea>

                            <span asp-validation-for="DescripcionPaquete"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-4">

                            <label class="form-label">
                                Fecha Requerida
                            </label>

                            <input asp-for="FechaRequerida"
                                   class="form-control"
                                   type="date"
                                   readonly="@bloqueado" />

                            <span asp-validation-for="FechaRequerida"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    @if (!string.IsNullOrEmpty(Model.HistorialCambios))
                    {
                        <div class="section-divider"></div>

                        <label class="form-label">
                            Historial de Cambios
                        </label>

                        <div class="historial-box">
                            @Model.HistorialCambios
                        </div>
                    }

                    <div class="section-divider"></div>

                    <div class="d-flex gap-3">

                        @if (!bloqueado)
                        {
                            <button type="submit"
                                    class="btn-gold">

                                Guardar Cambios

                            </button>
                        }

                        <a asp-action="Lista"
                           class="btn-outline">

                            Cancelar

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}