@model SISDELYPORT.Models.Solicitud
@{
    ViewData["Title"] = "Registrar Solicitud";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');
    body { background-color: #0d0a2e; color: white; font-family: 'DM Sans', sans-serif; }
    .page-wrap {
        background:
            radial-gradient(ellipse 90% 50% at 50% 0%, #3d2080 0%, transparent 55%),
            radial-gradient(ellipse 60% 40% at 0% 40%, #2a1260 0%, transparent 50%),
            radial-gradient(ellipse 60% 40% at 100% 60%, #2a1260 0%, transparent 50%),
            linear-gradient(180deg, #0d0a2e 0%, #130d3a 25%, #0f0b30 50%, #0d0a2e 100%);
        min-height: 100vh;
        padding: 60px 0 80px;
    }
    .page-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 6px;
    }
    .section-label {
        color: #c9a84c;
        letter-spacing: 4px;
        font-size: 0.72rem;
        text-transform: uppercase;
        font-weight: 500;
        margin-bottom: 10px;
    }
    .form-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        padding: 44px 40px;
        max-width: 800px;
        margin: 0 auto;
    }
    .form-label {
        color: rgba(255,255,255,0.6);
        font-size: 0.78rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 500;
        margin-bottom: 8px;
    }
    .form-control, .form-select {
        background: rgba(255,255,255,0.04) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        border-radius: 6px !important;
        color: white !important;
        padding: 12px 16px !important;
        font-family: 'DM Sans', sans-serif !important;
        font-size: 0.95rem !important;
        transition: border-color 0.3s !important;
    }
    .form-control:focus, .form-select:focus {
        border-color: rgba(201,168,76,0.5) !important;
        box-shadow: 0 0 0 3px rgba(201,168,76,0.08) !important;
        background: rgba(255,255,255,0.06) !important;
        outline: none !important;
    }
    .form-control::placeholder { color: rgba(255,255,255,0.2) !important; }
    .form-select option { background: #130d3a; color: white; }
    .text-danger { color: #f87171 !important; font-size: 0.8rem; }
    .info-box {
        background: rgba(201,168,76,0.06);
        border: 1px solid rgba(201,168,76,0.2);
        border-radius: 8px;
        padding: 16px 20px;
        color: rgba(255,255,255,0.45);
        font-size: 0.85rem;
        line-height: 1.7;
        margin-bottom: 28px;
    }
    .info-box strong { color: #c9a84c; }
    .btn-gold {
        background: linear-gradient(135deg, #c9a84c, #e8c96a);
        color: #08061a;
        padding: 13px 40px;
        border-radius: 3px;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }
    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(201,168,76,0.3);
    }
    .btn-back {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.5);
        padding: 13px 32px;
        border-radius: 3px;
        font-size: 0.85rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s;
        display: inline-block;
    }
    .btn-back:hover {
        border-color: rgba(201,168,76,0.3);
        color: #c9a84c;
    }
    .divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(201,168,76,0.2), transparent);
        margin: 32px 0;
    }
    .section-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(201,168,76,0.25), transparent);
        margin-bottom: 40px;
    }
</style>

<div class="page-wrap">
    <div class="container">

        <!-- Header -->
        <div class="text-center mb-5">
            <p class="section-label">Sistema DELYPORT</p>
            <h1 class="page-title">Registrar Solicitud</h1>
            <p style="color:rgba(255,255,255,0.3); font-size:0.9rem; margin-top:8px;">
                Completa los datos para registrar tu solicitud de delivery
            </p>
        </div>

        <div class="section-divider"></div>

        <div class="form-card">

            <div class="info-box">
                <strong>ℹ️ Información requerida:</strong> Todos los campos son obligatorios.
                Al completar el registro se generará automáticamente un código único para tu solicitud.
            </div>

            <form asp-action="Registrar" method="post">

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="NombreCliente" class="form-label">Nombre del Cliente</label>
                        <input asp-for="NombreCliente" class="form-control"
                               placeholder="Ej: Bodega El Sol" />
                        <span asp-validation-for="NombreCliente" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DistritoDestino" class="form-label">Distrito de Destino</label>
                        <select asp-for="DistritoDestino" class="form-select">
                            <option value="">-- Seleccione un distrito --</option>
                            @foreach (var d in ViewBag.Distritos as List<string>)
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                        <span asp-validation-for="DistritoDestino" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-8">
                        <label asp-for="DescripcionPaquete" class="form-label">Descripción del Paquete</label>
                        <textarea asp-for="DescripcionPaquete" class="form-control" rows="3"
                                  placeholder="Ej: Caja de electrodomésticos 20kg"></textarea>
                        <span asp-validation-for="DescripcionPaquete" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FechaRequerida" class="form-label">Fecha Requerida</label>
                        <input asp-for="FechaRequerida" class="form-control" type="date" />
                        <span asp-validation-for="FechaRequerida" class="text-danger small"></span>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="d-flex gap-3 flex-wrap">
                    <button type="submit" class="btn-gold">
                        Registrar Solicitud
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn-back">
                        Volver al Inicio
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}